{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal core permissions for the bundled local UI",
  "windows": ["main", "scanner"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart"
  ]
}
