{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Secretary",
  "version": "0.1.4",
  "identifier": "dev.sentinel.totp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Secretary",
        "width": 420,
        "height": 640,
        "minWidth": 420,
        "minHeight": 640,
        "maxWidth": 420,
        "maxHeight": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5OUY2NDE1MEI2NkI5RkMKUldUOHVXWUxGV1NmYVFiUWJqbkhYa1ozM3JSQituZndBU1hSU29qU0RlZEJVNWJqWE5jSnlIdksK",
      "endpoints": [
        "https://github.com/ds415057r4/secretary/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
